def mean_f(img, k=3, s=1):
# Image dimensions
h, w = img.shape
# Padding size
pad = k // 2
# Pad the image
padded = np.pad(img, pad, mode='reflect')
# Output image dimensions
out_h = (h - k + 2 * pad) // s + 1
out_w = (w - k + 2 * pad) // s + 1
# Output image
og = np.zeros((out_h, out_w), dtype=img.dtype)
# Apply mean filter
for i in range(out_h):
for j in range(out_w):
# Extract k×k window
window = padded[i*s:i*s+k, j*s:j*s+k]
# Compute mean
og[i, j] = np.mean(window)
return og
og = mean_f(noisy, k=3, s=1)
plt.imshow(og, cmap='gray')
plt.title("Mean Filtered Image")

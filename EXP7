LEVELS = 32
DISTANCES = [1, 3, 5]
ANGLES = [0, np.pi/4, np.pi/2, 3*np.pi/4]
def features_from_glcm(P):
 # P: normalised 2D GLCM (LEVELS x LEVELS). Returns dict of the 5
features.
 L = P.shape[0]
 i, j = np.meshgrid(np.arange(L), np.arange(L), indexing='ij')
 diff = i - j
 dissimilarity = np.sum(P * np.abs(diff))
 contrast = np.sum(P * diff ** 2)
 energy = np.sqrt(np.sum(P ** 2))
 homogeneity = np.sum(P / (1.0 + diff ** 2))
 mu_i = np.sum(i * P)
 mu_j = np.sum(j * P)
 sd_i = np.sqrt(np.sum(P * (i - mu_i) ** 2))
 sd_j = np.sqrt(np.sum(P * (j - mu_j) ** 2))
 if sd_i * sd_j == 0: # perfectly flat patch
 correlation = 1.0
 else:
 correlation = np.sum(P * (i - mu_i) * (j - mu_j)) / (sd_i *
sd_j)
 return dict(dissimilarity=dissimilarity, contrast=contrast,
energy=energy,
 homogeneity=homogeneity, correlation=correlation)
def patch_features(patch):
 q = (patch.astype(np.uint16) * LEVELS // 256).astype(np.uint8) #
quantise 256 -> 32 levels
 glcm = graycomatrix(q, distances=DISTANCES, angles=ANGLES,
 levels=LEVELS, symmetric=True, normed=True)
 per_offset = [features_from_glcm(glcm[:, :, d, a])
 for d in range(len(DISTANCES)) for a in
range(len(ANGLES))]
 return pd.DataFrame(per_offset).mean().to_dict() #
average over all offsets
df = pd.DataFrame([patch_features(p) for p in patches], index=names)
